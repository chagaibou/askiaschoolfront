# =========================================================
# .dockerignore — FRONT Next.js (askiaschoolfront)
# À placer à la racine du front, nommé EXACTEMENT ".dockerignore"
# Exclut du build ce qui est inutile ou régénérable.
# =========================================================

# Dépendances (réinstallées dans l'image via npm ci)
node_modules

# Build Next.js (régénéré via npm run build)
.next
out

# Secrets et config locale (NE DOIVENT PAS entrer dans l'image)
.env
.env.local
.env*.local

# Git
.git
.gitignore

# Logs et divers
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store

# Éditeurs
.vscode
.idea

# Docker lui-même
Dockerfile
.dockerignore